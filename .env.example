# CloudCostLens - Environment Variables Template
# Copy this file to .env and fill in your details.

# ==================== AWS CREDENTIALS ====================
# Required for Terraform provisioning. Use an IAM user with appropriate permissions.
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=us-east-1

# ==================== PLATFORM SECURITY ====================
# Password for the 'admin' user in the dashboard.
ADMIN_PASSWORD=admin123

# Secret key for JWT signing. Recommendation: Use a long random string.
# Example: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_here

# ==================== DATABASE ====================
# Supabase DB Password (Required)
SUPABASE_DB_PASSWORD=...

# Backend Admin
ADMIN_USERNAME=admin
