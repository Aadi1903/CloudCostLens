terraform/workspaces/
terraform/.terraform/
*.tfstate
*.tfstate.backup
.terraform.lock.hcl

# ====================
# Frontend (Node/Vite)
# ====================
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/stats.html

# ====================
# Sensitive
# ====================
.env
.env.local
Credentials.json
